{
	"name": "russiankisa",
	"version": "alpha",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "NITRO_PRESET=cloudflare_module nuxt build && rm -rf dist && cp -R .output dist && cp .output/server/index.mjs dist/server/index.js && mkdir -p dist/.openai && cp .openai/hosting.json dist/.openai/hosting.json",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"typecheck": "nuxt prepare && vue-tsc -b --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"nuxt": "^4.0.1",
		"trig-js": "^4.2.0"
	},
	"packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
	"devDependencies": {
		"@nuxtjs/tailwindcss": "^6.14.0",
		"@playwright/test": "^1.61.1",
		"@stagewise-plugins/vue": "^0.6.2",
		"@stagewise/toolbar": "^0.6.2",
		"@types/node": "^26.1.1",
		"sass": "^1.89.2",
		"typescript": "^5.8.3",
		"vue-tsc": "^3.0.1"
	}
}
